@startuml C3_server_design
!include common/_style.puml

title C3 – Patients (Server Design)

package "common" {
  package "Domain (entities)" {
    !include common/C3-common.puml!Patient
    !include common/C3-common.puml!Sex
  }

  package "Contracts (interfaces)" {
    !include common/shared-contracts.puml!AccessDeniedException
    !include common/C3-common.puml!DuplicatePatientException
    !include common/shared-contracts.puml!IAuditRecorder
    !include common/C3-common.puml!IPatientService
    !include common/C1-common.puml!IRoleManagementService
    !include common/shared-contracts.puml!ValidationException
  }

}

package "server" {
  package "Service (control)" {
    class PatientSeedData <<auxiliary>> {
      ~patients() : List<Patient>
    }

    class PatientService <<control>> {
      +loadSeedData() : void
      +searchPatients(requester : String, filters : String) : List<Patient> throws AccessDeniedException
      +getPatient(requester : String, patientId : String) : Patient throws AccessDeniedException, ValidationException
      +registerPatient(requester : String, patient : Patient) : Patient throws AccessDeniedException, ValidationException, DuplicatePatientException
      +modifyPatient(requester : String, patientId : String, patient : Patient) : Patient throws AccessDeniedException, ValidationException
    }

  }

  package "Persistence" {
    interface IPatientRepository {
      +findById(patientId : String) : Patient
      +findByIdentifier(identifier : String) : Patient
      +search(filters : String) : List<Patient>
      +save(patient : Patient) : void
    }

    class InMemoryPatientRepository {
      -patients : Map<String, Patient>
      +findById(patientId : String) : Patient
      +findByIdentifier(identifier : String) : Patient
      +search(filters : String) : List<Patient>
      +save(patient : Patient) : void
    }

  }

}

' ==================== Relationships ====================
Patient "*" -- "1" Sex : sex
DuplicatePatientException "*" -- "1" Patient : existingPatient
IPatientService ..> Patient : <<use>> «use»
PatientService ..|> IPatientService
InMemoryPatientRepository ..|> IPatientRepository
PatientService ..> IPatientRepository : <<use>>
PatientService ..> PatientSeedData : <<use>>
PatientService ..> IAuditRecorder : <<use>>
PatientService ..> IRoleManagementService : <<use>>
PatientService ..> ValidationException : <<throw>>
PatientService ..> DuplicatePatientException : <<throw>>
PatientService ..> AccessDeniedException : <<throw>>

' ==================== Notes ====================
note as N1
  realizes Control_ManagePatients (UC12)
end note
N1 .. PatientService

note as N2
  every access and change is registered: PATIENT_ACCESSED, PATIENT_REGISTERED, PATIENT_MODIFIED (D26)
end note
N2 .. PatientService

note as N3
  no delete: patients are deactivated (D-022); discharge comes in It8
end note
N3 .. InMemoryPatientRepository

@enduml
